# Copia este archivo como .env y completa los valores.

# API key de Anthropic. Si la dejas vacía, el SDK usa la sesión de Claude Code
# que tengas iniciada en este equipo.
ANTHROPIC_API_KEY=

# Modelo que usa el agente. Vacío = el modelo por defecto del SDK.
# Ejemplo: claude-sonnet-5-5
CANASTAI_MODEL=

# Nivel de logs: DEBUG, INFO, WARNING o ERROR.
CANASTAI_LOG_LEVEL=INFO
